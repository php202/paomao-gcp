# 收件人（Token 異常時寄到此信箱）
ADMIN_EMAIL=paopaomao.of@gmail.com

# 寄信用（Gmail 應用程式密碼，需開啟兩步驟驗證後產生）
GMAIL_USER=paopaomao.of@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxx

# SayDou Token（可改由 TOKEN_SHEET_SS_ID 試算表「預約表單」C2 讀取）
# SAYDOU_BEARER_TOKEN=...

# 試算表 ID（可選，有預設值；打卡 API 必填 LINE_STAFF_SS_ID）
# TOKEN_SHEET_SS_ID=...
# LINE_STAFF_SS_ID=...   # 打卡 API 必填：員工清單／打卡紀錄／公司列表 所在試算表
# LINE_STORE_SS_ID=...
# OUTPUT_SS_ID=...

# 員工業績月報選項（無月份上限，會處理 startYm～endYm 全部）
# TIPS_GODSID=201969
# FETCH_BATCH_SIZE=10

# 各店日報（GCP 直連 SayDou，避開 GAS UrlFetch 配額）
# PAO_CAT_CORE_API_URL=https://script.google.com/macros/s/xxxx/exec
# PAO_CAT_SECRET_KEY=xxxx
# DAILY_ACCOUNT_REPORT_SS_ID=1ZMutegYTLZ51XQHCbfFZ7-iAj1qTZGgSo5VTThXPQ5U
# DAILY_REPORT_BATCH_DELAY_MS=1500

# ---------- LINE Webhook 備援（node index.js serve 時需要）----------
# LINE Developers → 頻道 → Basic settings / Messaging API 取得
# LINE_CHANNEL_SECRET=xxxx
# LINE_TOKEN_PAOSTAFF=xxxx
# 員工試算表（同上 LINE_STAFF_SS_ID，須含員工清單、管理者清單、員工打卡紀錄）
# LINE_STAFF_SS_ID=xxxx
# 門市資料（Line問題集用）
# LINE_HQ_SS_ID=xxxx
# 訊息一覽表（店家回覆狀態用）
# LINE_STORE_SS_ID=xxxx
# 各店訊息一覽表（若與 LINE_STORE_SS_ID 不同才需設）
# INTEGRATED_SHEET_SS_ID=xxxx
# 公司流程試算表（員工指令「工作流程連結」用，須含工作表「公司流程」A=關鍵字 B=連結）
# WORKFLOW_SHEET_SS_ID=xxxx
# 打卡頁網址（可選，預設 https://www.paopaomao.tw/checkin）
# CHECK_IN_LINK=https://www.paopaomao.tw/checkin
# 非「我要打卡」事件轉發到 GAS 主 webhook（建議設定，避免備援模式下其他功能失效）
# GAS_WEBHOOK_URL=https://script.google.com/macros/s/xxxx/exec
# 是否把未搬遷指令轉發到 GAS（1=轉發，0=只走 GCP；預設 0）
# FORWARD_UNKNOWN_TO_GAS=0
# 神美日報頁面（改走 GCP 時設為 Cloud Run /report；若維持官網請保留 https://www.paopaomao.tw/report 並設 REPORT_API_BASE）
# REPORT_PAGE_URL=https://www.paopaomao.tw/report
# 報告頁在官網開啟時，必須設此項，讓頁面知道 report-api 位址（LINE 產生的連結會自動帶上 api_base 參數）
# REPORT_API_BASE=https://<your-cloud-run-url>/report-api
# 店家本月出勤：Drive 配額滿時可改在「共用資料夾」建立試算表（用該資料夾擁有者的配額）
# FOLDER_ID_FOR_ATTENDANCE_SHEETS=<Drive 資料夾 ID，需分享給 pao-sheets-creator@... 編輯者>
# 店家本月出勤（Excel + GCS）：若設定則改用 Excel 上傳至 Cloud Storage，取代 Google Sheets（避免 Drive 配額不足）
# GCS_BUCKET_ATTENDANCE=<GCS bucket 名稱，例：pao-attendance-excel；需賦予 Cloud Run / pao-sheets-sa 寫入權限>
# 神美日報_開啟紀錄試算表（泡泡貓 門市資料；未設則用 LINE_HQ_SS_ID）
# REPORT_ACCESS_LOG_SS_ID=1-t4KPVK-uzJ2xUoy_NR3d4XcUohLHVETEFXTlvj4baE
# 明日預約清單 API（可選，若要在 GCP 直接查明日預約）
# TOMORROW_BRIEFING_WEB_APP_URL=https://script.google.com/macros/s/xxxx/exec
# 本機跑 serve 時需設 Service Account JSON 路徑
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# 服務 port（可選，預設 8080）
# PORT=8080

# ---------- Legacy fallback（漸進搬遷期間用，完成後可移除） ----------
# LEGACY_GAS_CORE_API_URL=https://script.google.com/macros/s/xxxx/exec
# LEGACY_GAS_STORES_API_URL=https://script.google.com/macros/s/xxxx/exec

# ---------- /admin ----------
# ADMIN_KEY=xxxx  # 若未設，預設用 PAO_CAT_SECRET_KEY
# GCP_ADMIN_URL=https://<cloud-run-service>/admin  # 給 GAS UI shims 用
# GCP_ADMIN_KEY=xxxx  # 給 GAS UI shims 用（可同 ADMIN_KEY）

# ---------- Store bots webhook ----------
# /store-line-webhook 會依 destinationId 從「店家基本資料」查 channelSecret

# ---------- PAOPAO bot ----------
# PAOPAO_STORE_SS_ID=xxxx
# LINE_CHANNEL_SECRET_PAOPAO=xxxx
# LINE_TOKEN_PAOPAO=xxxx

# ---------- Odoo / Giveme（/core actions） ----------
# ODOO_URL=https://your-odoo-domain
# ODOO_DB=xxxx
# ODOO_USERNAME=xxxx
# ODOO_PASSWORD=xxxx
# GIVEME_PROXY_URL=https://your-vm-proxy
# GIVEME_UNCODE=xxxx
# GIVEME_IDNO=xxxx
# GIVEME_PASSWORD=xxxx
