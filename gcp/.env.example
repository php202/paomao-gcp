# 收件人（Token 異常時寄到此信箱）
ADMIN_EMAIL=paopaomao.of@gmail.com

# 寄信用（Gmail 應用程式密碼，需開啟兩步驟驗證後產生）
GMAIL_USER=paopaomao.of@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxx

# SayDou Token（可改由 TOKEN_SHEET_SS_ID 試算表「預約表單」C2 讀取）
# SAYDOU_BEARER_TOKEN=...

# 試算表 ID（可選，有預設值；打卡 API 必填 LINE_STAFF_SS_ID）
# TOKEN_SHEET_SS_ID=...
# LINE_STAFF_SS_ID=...   # 打卡 API 必填：員工清單／打卡紀錄／公司列表 所在試算表
# LINE_STORE_SS_ID=...
# OUTPUT_SS_ID=...

# 員工業績月報選項（無月份上限，會處理 startYm～endYm 全部）
# TIPS_GODSID=201969
# FETCH_BATCH_SIZE=10

# 各店日報（GCP 直連 SayDou，避開 GAS UrlFetch 配額）
# PAO_CAT_CORE_API_URL=https://script.google.com/macros/s/xxxx/exec
# PAO_CAT_SECRET_KEY=xxxx
# DAILY_ACCOUNT_REPORT_SS_ID=1ZMutegYTLZ51XQHCbfFZ7-iAj1qTZGgSo5VTThXPQ5U
# DAILY_REPORT_BATCH_DELAY_MS=1500

# ---------- LINE Webhook 備援（node index.js serve 時需要）----------
# LINE Developers → 頻道 → Basic settings / Messaging API 取得
# LINE_CHANNEL_SECRET=xxxx
# LINE_TOKEN_PAOSTAFF=xxxx
# 員工試算表（同上 LINE_STAFF_SS_ID，須含員工清單、管理者清單、員工打卡紀錄）
# LINE_STAFF_SS_ID=xxxx
# 打卡頁網址（可選，預設 https://www.paopaomao.tw/checkin）
# CHECK_IN_LINK=https://www.paopaomao.tw/checkin
# 非「我要打卡」事件轉發到 GAS 主 webhook（建議設定，避免備援模式下其他功能失效）
# GAS_WEBHOOK_URL=https://script.google.com/macros/s/xxxx/exec
# 本機跑 serve 時需設 Service Account JSON 路徑
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# 服務 port（可選，預設 8080）
# PORT=8080
