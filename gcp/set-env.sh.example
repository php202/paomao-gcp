#!/bin/bash
# 複製為 set-env.sh 並填入實際值：cp set-env.sh.example set-env.sh
# 部署前執行：source set-env.sh && ./deploy-line-webhook.sh
# 勿提交 set-env.sh（內含密鑰，已在 .gitignore）

# ----- 必填（部署時會檢查）-----
export PROJECT_ID=your-gcp-project-id
export REGION=asia-east1
export LINE_STAFF_SS_ID=   # 員工清單／打卡紀錄／管理者清單 所在試算表 ID
export LINE_CHANNEL_SECRET=   # LINE 頻道 → Basic settings → Channel secret
export LINE_TOKEN_PAOSTAFF=  # LINE 頻道 → Messaging API → Channel access token

# ----- 選填（試算表／日報等）-----
export TOKEN_SHEET_SS_ID=
export LINE_STORE_SS_ID=
export OUTPUT_SS_ID=
export FETCH_BATCH_SIZE=10
export DAILY_REPORT_CRON="10 0 * * *"

# ----- Core API（神美日報、上月小費、我要了解客人）- 必填才會正常 -----
# PAO_CAT_CORE_API_URL = PaoMao_Core 在 GAS 的「網路應用程式」部署網址，結尾 /exec
#   取得：GAS → PaoMao_Core 專案 → 部署 → 管理部署 → 複製「網路應用程式」那筆網址
# PAO_CAT_SECRET_KEY = 與 PaoMao_Core 專案「指令碼屬性」裡設的 PAO_CAT_SECRET_KEY 相同
export PAO_CAT_CORE_API_URL=
export PAO_CAT_SECRET_KEY=

# Token 異常／查空位除錯時 LINE Push 通知管理員（check-token、store-line-webhook；使用員工打卡 bot 推播）
# export ADMIN_LINE_USER_ID=Ud77845386e2e6b3ceb79331978289809   # 管理員 LINE User ID（須已加員工打卡 bot 為好友）
# 選填：若仍要寄信可設
# export ADMIN_EMAIL=paopaomao.of@gmail.com
# export GMAIL_USER=paopaomao.of@gmail.com
# export GMAIL_APP_PASSWORD=xxxx   # Gmail 應用程式密碼（兩步驟驗證後產生）

# 店家本月出勤 403 時可設：Secret Manager 密碼名稱（見 docs/店家本月出勤_改用金鑰建立試算表.md）
# export SA_KEY_SECRET_NAME=pao-sheets-sa-key

# ----- Giveme 電子發票（/giveme-invoice：Saydou 結帳同步開單）-----
# 若使用 VM 中繼站（白名單用中繼站 IP），設 GIVEME_PROXY_URL 後開單會改打中繼站
# export GIVEME_PROXY_URL=http://136.115.207.151:8080/invoice
# export GIVEME_UNCODE=   # 貴司統一編號（fallback，各店以試算表 M/N 為主）
# export GIVEME_IDNO=     # API 帳號
# export GIVEME_PASSWORD= # API 密碼

# ----- 門市預約表單 PAOPAO（/paopao-line-webhook）- 必填才會收訊與回覆 -----
export PAOPAO_STORE_SS_ID=   # 門市預約表單試算表 ID（與 GAS Config.js 同）
export LINE_CHANNEL_SECRET_PAOPAO=   # 門市預約表單「此」頻道 → Basic settings → Channel secret（與員工打卡不同）
export LINE_TOKEN_PAOPAO=   # 門市預約表單 頻道 → Messaging API → Channel access token

echo "Set PROJECT_ID=$PROJECT_ID REGION=$REGION"
echo "請在 set-env.sh 填入上述必填與選填值（勿提交 set-env.sh）"
